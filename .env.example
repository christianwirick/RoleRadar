# Role Radar configuration.
# Recommended: keep the real file outside the repository:
#   mkdir -p ~/.config/RoleRadar
#   cp .env.example ~/.config/RoleRadar/.env
#   ln -s ~/.config/RoleRadar/.env .env
#   chmod 600 ~/.config/RoleRadar/.env
# The real .env must never be committed.

# --- Job board ---------------------------------------------------------------
# The page that lists the roles you want to watch.
JOB_BOARD_URL=https://careers.example.com/openings

# Comma-separated keywords. A role matches if its title contains any of these
# (case-insensitive).
JOB_TITLES=analyst, data analyst, analytics

# Optional: comma-separated titles to always skip.
EXCLUDE_TITLES=IT Support Analyst

# Optional: CSS class of each job-title element on the board (advanced).
JOB_ITEM_CLASS=vizi-item-title

# --- Email (configurable SMTP; Gmail shown as the example) -------------------
EMAIL_USER=you@example.com

# For Gmail, create an App Password (NOT your normal password):
#   https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your-app-password-here

# Optional: where alerts are sent (defaults to EMAIL_USER).
EMAIL_TO=you@example.com

# SMTP server. Defaults shown work for Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
